<UserControl x:Class="ThomasHarper_Cs_Project.Views.Admin"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ThomasHarper_Cs_Project.Views"
             mc:Ignorable="d" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <TextBlock Text="Admin Page" Grid.ColumnSpan="2" FontSize="20"
                   HorizontalAlignment="Center"/>

        <TextBox Name="tbTaskTitle" 
                 Grid.Row="1" 
                 Height="45" Width="250"
                 materialDesign:HintAssist.Hint="Task Title"
                 materialDesign:TextFieldAssist.UnderlineBrush="Black"/>

        <TextBox Name="tbTaskDescription" 
                 Grid.Row="2" 
                 Height="45" Width="250"
                 materialDesign:HintAssist.Hint="Task Description"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 materialDesign:TextFieldAssist.UnderlineBrush="Black"/>

        <TextBox Name="tbTaskAssignedTo" 
                 Grid.Row="3" 
                 Height="45" Width="250"
                 materialDesign:HintAssist.Hint="Assign task to"
                 materialDesign:TextFieldAssist.UnderlineBrush="Black"/>

        <Button Name="btnAddTask" Click="btnAddTask_Click"
                Grid.Row="4" Width="150" BorderThickness="0"
                Content="Add Task" Background="Black"/>
    </Grid>
</UserControl>
