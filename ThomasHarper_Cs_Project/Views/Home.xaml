<UserControl x:Class="ThomasHarper_Cs_Project.Views.Home"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ThomasHarper_Cs_Project.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Home" Grid.ColumnSpan="2" HorizontalAlignment="Center"
                   FontSize="20"/>
        
        <!--display item lowest in stock-->
        <Grid>
            <StackPanel Margin="100">
                <TextBlock Text="Lowest Stock Item"
                           HorizontalAlignment="Center"
                           FontSize="15"/>
                <TextBlock Name="tbLowestItemName" HorizontalAlignment="Center"/>
                <TextBlock Name="tbLowestItemCost" HorizontalAlignment="Center"/>
                <TextBlock Name="tbLowestItemReplenishTime" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
        
        
        <!--display a task to the user-->
        <Grid Grid.Column="1">
            <StackPanel Margin="100">
                <TextBlock Text="Task"
                           HorizontalAlignment="Center"
                           FontSize="15"/>
                <TextBlock Name="tbTaskTitle" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
