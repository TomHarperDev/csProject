<Window x:Class="ThomasHarper_Cs_Project.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ThomasHarper_Cs_Project"
        mc:Ignorable="d"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.2*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        
        <!--nav bar-->
        <Grid Background="#222222">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <StackPanel>
                <!--home-->
                <Grid Margin="0,10,0,0" Height="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.3*"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="Home" HorizontalAlignment="Center" Foreground="White"/>
                    <TextBlock Text="Home" Foreground="White" Grid.Column="1"/>
                    <Button Grid.ColumnSpan="2" Background="Transparent" BorderThickness="0"
                            Name="btnHome" Click="btnHome_Click"/>
                </Grid>

                <!--Products-->
                <Grid Margin="0,10,0,0" Height="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.3*"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="Database" HorizontalAlignment="Center" Foreground="White"/>
                    <TextBlock Text="Products" Foreground="White" Grid.Column="1"/>
                    <Button Grid.ColumnSpan="2" Background="Transparent" BorderThickness="0"
                            Name="btnProducts" Click="btnProducts_Click"/>
                </Grid>

                <!--Admin-->
                <Grid Margin="0,10,0,0" Height="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.3*"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="Administrator" HorizontalAlignment="Center" Foreground="White"/>
                    <TextBlock Text="Admin" Foreground="White" Grid.Column="1"/>
                    <Button Grid.ColumnSpan="2" Background="Transparent" BorderThickness="0"
                            Name="btnAdmin" Click="btnAdmin_Click"/>
                </Grid>

                <!--Task-->
                <Grid Margin="0,10,0,0" Height="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.3*"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="TaskAdd" HorizontalAlignment="Center" Foreground="White"/>
                    <TextBlock Text="Task" Foreground="White" Grid.Column="1"/>
                    <Button Grid.ColumnSpan="2" Background="Transparent" BorderThickness="0"
                            Name="btnTask" Click="btnTask_Click"/>
                </Grid>

                <!--Logout-->
               
            </StackPanel>
        </Grid>
        <Grid Margin="0,10,0,0" Height="20" VerticalAlignment="Bottom">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.3*"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <materialDesign:PackIcon Kind="Logout" HorizontalAlignment="Center" Foreground="White"/>
            <TextBlock Text="Logout" Foreground="White" Grid.Column="1"/>
            <Button Grid.ColumnSpan="2" Background="Transparent" BorderThickness="0"
             Name="btnLogout" Click="btnLogout_Click"/>
        </Grid>


        <Grid Grid.Column="1" Name="parentGrid">
            
        </Grid>
    </Grid>
</Window>
